#!/usr/bin/env bash
set -euo pipefail
runtime_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
configured_home='/home/chris/PDSL/vdbench50406'
if [[ "$runtime_dir" != '/home/chris/idfs-workloads/workloads/hot_cold/ai_inference_ses/rendered' || ${VDBENCH_HOME:-$configured_home} != "$configured_home" ]]; then
  printf '%s\n' 'Render again for this bundle path and Vdbench installation.' >&2
  exit 2
fi
require_sha() {
  local observed
  observed=$(sha256sum -- "$1")
  if [[ ${observed%% *} != "$2" ]]; then
    printf 'User runtime checksum mismatch: %s\n' "$1" >&2
    exit 2
  fi
}
stock_jar="$configured_home/vdbench.jar"
extension="$runtime_dir/ai-user.jar"
require_sha "$stock_jar" '8a87321b1b3cd6b60a5251a149359b628dd95a52b93efd7a990703478cfbf4d5'
require_sha "$extension" 'ba9c23df444e6f3fac240d7961954128fdcfd798de22eff10062183e5d7ab712'
require_sha "$runtime_dir/runtime.json" '94252078f29a1bc0031ef1688f3e01a783ad9f67270eac67d0f68bfbc3c52e04'
require_sha "$runtime_dir/stock-home" 'f125e283e1cfa2608438f0ed15bfaa7e76480bea0632e733e744cc72090c2844'
unset JDK_JAVA_OPTIONS JAVA_TOOL_OPTIONS _JAVA_OPTIONS
if [[ -n ${JAVA_HOME:-} ]]; then
  java="$JAVA_HOME/bin/java"
elif [[ -x "$configured_home/jre/bin/java" ]]; then
  java="$configured_home/jre/bin/java"
else
  java=/usr/bin/java
fi
main=Vdb.Vdbmain
heap=${VDBENCH_MAIN_XMX:-512m}
if [[ ${1:-} == SlaveJvm ]]; then
  main=Vdb.SlaveJvm
  heap=${VDBENCH_SLAVE_XMX:-2048m}
fi
cd -- "$runtime_dir"
opts=(-XX:-UsePerfData -Xms64m -Xmx"$heap")
if [[ -n ${TMPDIR:-} ]]; then
  opts+=("-Djava.io.tmpdir=$TMPDIR")
fi
exec "$java" "${opts[@]}" -cp "$stock_jar:$extension" "$main" "$@"
