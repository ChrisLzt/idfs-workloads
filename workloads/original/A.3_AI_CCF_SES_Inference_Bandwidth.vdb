data_errors=1
create_anchors=yes
messagescan=nodisplay

hd=default,vdbench=/root/vdbench50406,user=root,shell=ssh
hd=hd1,system=client14
…
hd=hd16,system=client216

fsd=default,openflags=o_direct,shared=yes
fsd=fsd0,anchor=/mnt/cephfs/ai/dir0,depth=3,width=6,files=10,size=(512M,30,1G,40,2G,30)
fsd=fsd1,anchor=/mnt/cephfs/ai/dir1,depth=3,width=6,files=10,size=(512M,30,1G,40,2G,30)
fsd=fsd2,anchor=/mnt/cephfs/ai/dir2,depth=3,width=6,files=10,size=(512M,30,1G,40,2G,30)
fsd=fsd3,anchor=/mnt/cephfs/ai/dir3,depth=3,width=6,files=10,size=(512M,30,1G,40,2G,30)
fsd=fsd4,anchor=/mnt/cephfs/ai/dir4,depth=3,width=6,files=10,size=(512M,30,1G,40,2G,30)
fsd=fsd5,anchor=/mnt/cephfs/ai/dir5,depth=3,width=6,files=10,size=(512M,30,1G,40,2G,30)
fsd=fsd6,anchor=/mnt/cephfs/ai/dir6,depth=3,width=6,files=10,size=(512M,30,1G,40,2G,30)
fsd=fsd7,anchor=/mnt/cephfs/ai/dir7,depth=3,width=6,files=10,size=(512M,30,1G,40,2G,30)
fsd=fsd8,anchor=/mnt/cephfs/ai/dir8,depth=3,width=6,files=10,size=(512M,30,1G,40,2G,30)

fwd=format,thread=128,xfersize=4m
fwd=default,thread=768
fwd=fwd1,fsd=(fsd0-fsd8),operation=write,xfersize=128k,fileio=sequential,fileselect=sequential,skew=10
fwd=fwd2,fsd=(fsd0-fsd8),operation=write,xfersize=64k,fileio=sequential,fileselect=sequential,skew=10
fwd=fwd3,fsd=(fsd0-fsd8),operation=read,xfersize=128k,fileio=sequential,fileselect=sequential,skew=20
fwd=fwd4,fsd=(fsd0-fsd8),operation=read,xfersize=64k,fileio=sequential,fileselect=sequential,skew=20
fwd=fwd5,fsd=(fsd0-fsd8),operation=read,xfersize=128k,fileio=random,fileselect=random,skew=20
fwd=fwd6,fsd=(fsd0-fsd8),operation=read,xfersize=64k,fileio=random,fileselect=random,skew=20

rd=rd1,fwd=fwd*,fwdrate=max,format=restart,elapsed=600,interval=1,warmup=60
