#!/usr/bin/env bash
set -euo pipefail
runtime_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
stock_home='@STOCK_HOME@'
if [[ "$runtime_dir" != '@RUNTIME_DIR@' ]]; then
  printf '%s\n' 'FAST bundle moved. Render for its deployment directory.' >&2
  exit 2
fi
require_sha() {
  local checksum
  checksum=$(sha256sum -- "$1")
  if [[ ${checksum%% *} != "$2" ]]; then
    printf 'FAST runtime checksum mismatch: %s\n' "$1" >&2
    exit 2
  fi
}
stock_jar="$stock_home/vdbench.jar"
extension="$runtime_dir/fast-user.jar"
require_sha "$stock_jar" '@STOCK_SHA@'
require_sha "$extension" '@EXTENSION_SHA@'
unset JDK_JAVA_OPTIONS JAVA_TOOL_OPTIONS _JAVA_OPTIONS
if [[ -n ${JAVA_HOME:-} ]]; then
  java="$JAVA_HOME/bin/java"
elif [[ -x "$stock_home/jre/bin/java" ]]; then
  java="$stock_home/jre/bin/java"
else
  java=/usr/bin/java
fi
main=Vdb.Vdbmain
heap=${VDBENCH_MAIN_XMX:-512m}
if [[ ${1:-} == SlaveJvm ]]; then
  main=Vdb.SlaveJvm
  heap=${VDBENCH_SLAVE_XMX:-512m}
fi
cd -- "$runtime_dir"
args=(-XX:-UsePerfData -Xms64m -Xmx"$heap")
if [[ -n ${TMPDIR:-} ]]; then
  args+=("-Djava.io.tmpdir=$TMPDIR")
fi
exec "$java" "${args[@]}" -cp "$stock_jar:$extension" "$main" "$@"
